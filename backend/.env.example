# ── App settings ──────────────────────────────────────────────────────────────
# Password family members use to log in
APP_PASSWORD=billingapp2025

# JWT secret — change this to a long random string in production!
SECRET_KEY=change-me-in-production-secret-key-32chars

# How long login tokens stay valid (hours)
TOKEN_EXPIRE_HOURS=72

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./bills.db
# PostgreSQL (switch when ready):
# DATABASE_URL=postgresql://user:password@localhost:5432/billing

# ── Electricity rates ─────────────────────────────────────────────────────────
# Default rate (BDT per unit)
ELECTRICITY_RATE=9.0
# High rate applied when units_used exceeds threshold
ELECTRICITY_RATE_HIGH=10.0
# Set >0 to enable tiered billing (0 = flat rate only)
ELECTRICITY_RATE_THRESHOLD=0

